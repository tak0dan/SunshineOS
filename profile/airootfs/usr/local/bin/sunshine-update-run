#!/usr/bin/env bash
# Safe, friendly full-system update. Runs as root: sudo in a terminal, polkit from a launcher.
set -uo pipefail
# shellcheck disable=SC2034 # fallback colour names mirror ui.sh even when some are unused here
[ -r /usr/local/lib/sunshine/ui.sh ] && . /usr/local/lib/sunshine/ui.sh || { B=; Y=; G=; R=; N=; say() { echo "* $*"; }; ok() { echo "+ $*"; }; bad() { echo "x $*"; }; loc() { printf '%s' "$*"; }; t() { printf '%s' "${2:-$1}"; }; cozy_done() { :; }; sun_success_anim() { :; }; sun_exec_priv() { if [ "$(id -u)" -eq 0 ]; then exec "$@"; fi; if [ -t 0 ] && [ -t 1 ]; then exec sudo "$@"; fi; exec pkexec "$@"; }; }
finish() { echo; [ -n "${SUNSHINE_UPDATE_HERE:-}" ] || read -rp "Press Enter to close this window." _; exit "${1:-0}"; }   # run from a terminal (SUNSHINE_UPDATE_HERE): no window to close

# A terminal asks for the password in that terminal; only a desktop launcher uses the polkit prompt.
[ "$(id -u)" -eq 0 ] || sun_exec_priv "$0" "$@"
REAL_USER=${SUDO_USER:-}                            # sudo keeps the invoking user here
if [ -z "$REAL_USER" ] && [ -n "${PKEXEC_UID:-}" ]; then REAL_USER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1); fi  # polkit uses PKEXEC_UID

# The live session (not sunshine-rescue's chroot): the root is a RAM overlay and the running kernel comes from the ISO. Upgrading the kernel
# package there deletes /usr/lib/modules/<running kernel>, so no further module can load (nf_tables, USB, btrfs for the installer...).
# Updating stays possible (useful for testing), but the kernel package that owns the running kernel's modules is held back.
HOLD=""
if [ -d /run/archiso ] && [ -z "${SUNSHINE_IN_RESCUE:-}" ]; then
  kpkg=$(pacman -Qqo "/usr/lib/modules/$(uname -r)" 2>/dev/null | head -1)
  [ -n "$kpkg" ] && HOLD="--ignore $kpkg,$kpkg-headers"
  printf '\n%sThis is the live session.%s Updates here live in memory and are gone after a restart; to update for good, install Sunshine OS first.\n' "$Y$B" "$N"
  [ -n "$kpkg" ] && printf '  The running kernel (%s) is kept: upgrading it here would remove the drivers of the kernel that is running.\n' "$kpkg"
  read -rp "Update the live session anyway? [y/N] " a; [ "${a,,}" = y ] || finish 0
fi

# The live session (not sunshine-rescue's chroot): the root is a RAM overlay and the running kernel comes from the ISO. Upgrading the kernel
# package there deletes /usr/lib/modules/<running kernel>, so no further module can load (nf_tables, USB, btrfs for the installer...).
# Updating stays possible (useful for testing), but the kernel package that owns the running kernel's modules is held back.
HOLD=""
if [ -d /run/archiso ] && [ -z "${SUNSHINE_IN_RESCUE:-}" ]; then
  kpkg=$(pacman -Qqo "/usr/lib/modules/$(uname -r)" 2>/dev/null | head -1)
  [ -n "$kpkg" ] && HOLD="--ignore $kpkg,$kpkg-headers"
  printf '\n%sThis is the live session.%s Updates here live in memory and are gone after a restart; to update for good, install Sunshine OS first.\n' "$Y$B" "$N"
  [ -n "$kpkg" ] && printf '  The running kernel (%s) is kept: upgrading it here would remove the drivers of the kernel that is running.\n' "$kpkg"
  read -rp "Update the live session anyway? [y/N] " a; [ "${a,,}" = y ] || finish 0
fi

say "Sunshine OS update"
printf '%sGood to know:%s while the update runs you may see lines such as "WARNING: Possibly missing firmware for module: qat_6xxx" or "consolefont: no font found".\n  They come from building the boot image, are normal on Arch systems and mean only that this computer has no such device: you can ignore them.\n  Real problems are listed in a summary at the end, and the whole output is kept in /var/log/sunshine/update.log.\n' "$Y$B" "$N"
# the newest Sunshine tools first (signed release from the tools repository): a repair tool fixed yesterday works today, without a new ISO
if [ -x /usr/local/bin/sunshine-toolsync ]; then say "Sunshine tools"; /usr/local/bin/sunshine-toolsync update || true; fi
/usr/local/bin/sunshine-repo ensure --quiet   # the [sunshine] repository must be in pacman.conf (it can be lost with a merged pacman.conf)
if [ -e /var/lib/pacman/db.lck ]; then
  if pgrep -x pacman >/dev/null; then bad "Another update or install is running. Close it and try again."; finish 1; fi
  bad "A stale lock file was found (no package manager is running); removing it."
  rm -f /var/lib/pacman/db.lck
fi
# several independent methods (HTTPS first, then mirror, connectivity-check pages, TCP, NetworkManager, ping last): never "no internet" just because ping is blocked
if ! sun_online; then bad "$(sun_net_explain)"; finish 1; fi
[ -n "${SUN_NET_METHOD:-}" ] && ok "Internet reachable ($SUN_NET_METHOD)"

say "Latest Arch Linux news (read if something looks important)"
curl -fsS --max-time 8 https://archlinux.org/feeds/news/ 2>/dev/null \
  | grep -o '<title>[^<]*</title>' | sed -n '2,4p' | sed 's/<[^>]*>//g;s/^/  • /' || true

# Arch announces breaking changes in the news ("manual intervention required"): if a recent item says so, stop and make the user read it
news=$(curl -fsS --max-time 8 https://archlinux.org/feeds/news/ 2>/dev/null | python3 -c '
import sys,re,datetime,email.utils
x=sys.stdin.read()
for it in re.findall(r"<item>(.*?)</item>",x,re.S)[:4]:
    t=re.search(r"<title>(.*?)</title>",it,re.S); d=re.search(r"<pubDate>(.*?)</pubDate>",it,re.S); b=re.search(r"<description>(.*?)</description>",it,re.S)
    if not (t and d): continue
    age=(datetime.datetime.now(datetime.timezone.utc)-email.utils.parsedate_to_datetime(d.group(1))).days
    if age<=21 and re.search(r"intervention|manual|requires? (manual|action)|before (you )?upgrad",t.group(1)+(b.group(1) if b else ""),re.I): print(t.group(1))' 2>/dev/null)
if [ -n "$news" ]; then
  printf '\n%sArch Linux announced a change that may need your action before updating:%s\n  %s\n  https://archlinux.org/news/\n' "$Y$B" "$N" "$news"
  read -rp "Have you read it and want to continue anyway? [y/N] " a; [ "${a,,}" = y ] || finish 0
fi
say "Checking for updates"
if command -v checkupdates >/dev/null; then
  list=$(sudo -u "${REAL_USER:-nobody}" checkupdates 2>/dev/null || true)
  n=$(printf '%s' "$list" | grep -c . || true)
  [ "$n" -gt 0 ] && { echo "$n package update(s) available."; } || echo "$(loc "No system package updates right now.")"
fi

# a kernel update without the matching NVIDIA module (prebuilt packages move together) would boot to a black screen
if command -v checkupdates >/dev/null && pacman -Qq 2>/dev/null | grep -qE '^nvidia-open(-lts)?$'; then
  ups=$(sudo -u "${REAL_USER:-nobody}" checkupdates 2>/dev/null | awk '{print $1}')
  for pair in linux:nvidia-open linux-lts:nvidia-open-lts; do k=${pair%%:*}; n=${pair##*:}
    if grep -qx "$k" <<<"$ups" && pacman -Qq "$n" >/dev/null 2>&1 && ! grep -qx "$n" <<<"$ups"; then
      bad "The update has a new $k but not yet a matching $n: the NVIDIA driver would not load. Try again in a few hours (the mirrors are still syncing)."; finish 1; fi
  done
fi
if command -v faillock >/dev/null && [ -n "${REAL_USER:-}" ] && faillock --user "$REAL_USER" 2>/dev/null | grep -q '^[0-9]'; then faillock --user "$REAL_USER" --reset && ok "Login lock of $REAL_USER cleared (too many wrong passwords earlier)"; fi
if [ "$(findmnt -no FSTYPE /)" = btrfs ] && [ -e /etc/snapper/configs/root ]; then
  ok "Restore points are made automatically before and after the update (go back from the boot menu if anything breaks)"
fi
/usr/local/bin/sunshine-identity check --quiet || { /usr/local/bin/sunshine-identity apply --quiet && ok "System identity restored"; }

say "Refreshing the mirror list"
refresh_mirrors() {   # rate-mirrors ranks the mirrors by speed; the old list is kept if anything goes wrong
  command -v rate-mirrors >/dev/null || { bad "rate-mirrors is not installed yet (it is installed after this update and used next time): keeping the current list"; return 0; }
  local target new
  for target in arch:/etc/pacman.d/mirrorlist chaotic-aur:/etc/pacman.d/chaotic-mirrorlist; do
    [ -f "${target#*:}" ] || continue
    new=$(mktemp); cp -n "${target#*:}" "${target#*:}.sunshine-backup" 2>/dev/null
    if rate-mirrors --allow-root --protocol https --save="$new" "${target%%:*}" >/dev/null 2>&1 && grep -q '^Server' "$new"; then
      install -m644 "$new" "${target#*:}" && ok "${target%%:*} mirrors ranked"
    else bad "could not rank the ${target%%:*} mirrors: keeping the current list"; fi
    rm -f "$new"
  done
}
refresh_mirrors

say "Updating system packages"
free_mb=$(df --output=avail -BM / | tail -1 | tr -dc 0-9)
if [ "${free_mb:-9999}" -lt 1500 ]; then bad "Less than 1.5 GB is free on the system disk: the update could fail halfway. Free some space first (sunshine-cleanup)."; finish 1; fi
# the keyring first: a system that was off for months cannot verify new packages with its old keyring (what garuda-update does)
pacman -Sy --noconfirm --needed archlinux-keyring >/dev/null 2>&1 && ok "Package keyring is current"
# pacman -Su with one smart retry (the idea is Garuda's garuda-update): read WHY it failed and fix exactly that
run_update() {
  local log rc reason extra=()
  mkdir -p /var/log/sunshine; log=$(mktemp)
  LANG=C script -qefc "pacman -Su $HOLD" "$log"; rc=$?      # script keeps the terminal live (prompts, progress) and records the output
  cat "$log" >> /var/log/sunshine/update.log
  [ "$rc" -eq 0 ] && { rm -f "$log"; return 0; }
  reason=$(sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$log" | tr -d '\r' | grep -oP '(?<=error: failed to commit transaction \().*(?=\))' | tail -1)
  case "$reason" in
    "invalid or corrupted package"*|*"PGP signature"*)
      bad "A downloaded package was damaged. Removing the bad download and trying once more with a fresh key list."
      sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$log" | grep -oP '[^ ]+\.pkg\.tar\.[a-z]+' | sort -u | while read -r f; do rm -f "/var/cache/pacman/pkg/$(basename "$f")" "/var/cache/pacman/pkg/$(basename "$f").sig"; done
      pacman -Sy --noconfirm --needed archlinux-keyring >/dev/null 2>&1; pacman-key --populate >/dev/null 2>&1 ;;
    "download library error"|*"failed retrieving"*)
      bad "A download failed. Trying again with one connection at a time and fresh mirrors."
      refresh_mirrors; extra=(--disable-download-timeout) ;;
    "conflicting files")
      if sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$log" | grep 'exists in filesystem' | grep -qv '__pycache__/.*\.pyc'; then rm -f "$log"; bad "Files of another package are in the way (see above). They are not harmless Python caches, so nothing is overwritten automatically."; return 1; fi
      bad "Only Python cache files were in the way: overwriting those and trying again."; extra=(--overwrite '/usr/lib/python*/site-packages/*/__pycache__/*.pyc') ;;
    *) rm -f "$log"; return 1 ;;
  esac
  rm -f "$log"; local log2; log2=$(mktemp)
  LANG=C script -qefc "pacman -Su $HOLD ${extra[*]}" "$log2"; rc=$?
  cat "$log2" >> /var/log/sunshine/update.log; rm -f "$log2"
  return $rc
}
if grep -qE 'subvol=@?/.snapshots/[0-9]+/snapshot' /proc/cmdline; then bad "You booted into a restore point (snapshot): updating here would be lost or break it. Restore it first from the boot menu or sunshine-snapshot, then update."; finish 1; fi
if run_update; then ok "System packages are up to date"
  # a new sunshine-base may bring new repositories (Chaotic-AUR): add them now and update once more
  rm -f /run/sunshine-repo-changed; /usr/local/bin/sunshine-repo ensure --quiet; [ -e /run/sunshine-repo-changed ] && { say "New repository added: updating again"; pacman -Syu --noconfirm $HOLD; }
  command -v rate-mirrors >/dev/null || { pacman -S --noconfirm --needed rate-mirrors >/dev/null 2>&1 && refresh_mirrors; }
else bad "The system update did not finish. Nothing is broken by stopping; you can run the update again."; finish 1; fi

# Sirius (declarative): upgrade the Nix profiles, then make the system match /etc/sunshine/declarative.toml
if [ -x /usr/local/bin/sunshine-declare ]; then
  say "Declarative setup (Sirius)"
  command -v nix >/dev/null && { nix profile upgrade --all --profile /nix/var/nix/profiles/sunshine >/dev/null 2>&1; nix-channel --update >/dev/null 2>&1; } && ok "Nix packages are up to date"
  /usr/local/bin/sunshine-declare apply
fi

if command -v flatpak >/dev/null && flatpak remotes 2>/dev/null | grep -q .; then
  say "Updating Flatpak apps"; flatpak update -y --noninteractive || true; flatpak repair --noninteractive >/dev/null 2>&1 || true
fi
aurh=$(command -v paru || command -v yay || true)
if [ -n "$aurh" ] && [ -n "${REAL_USER:-}" ]; then
  say "Updating AUR (community) packages"; sudo -u "$REAL_USER" "$aurh" -Sua --noconfirm --needed || true
fi

if [ -x /usr/local/bin/sunshine-doctor ]; then say "Final health check"; /usr/local/bin/sunshine-doctor --quiet --fix || true; fi
say "Tidying up"
command -v paccache >/dev/null && paccache -rqk2 && ok "Old package cache cleaned"
orph=$(pacman -Qdtq 2>/dev/null || true)
[ -n "$orph" ] && echo "Unused packages (you can remove later): $(echo $orph | wc -w)"
[ -x /usr/local/bin/sunshine-pacnew ] && /usr/local/bin/sunshine-pacnew auto 2>/dev/null | sed 's/^/  /'
pn=$(find /etc -name '*.pacnew' 2>/dev/null | head -5)
[ -n "$pn" ] && { echo "$(loc "Config updates waiting for review (*.pacnew):")"; echo "$pn"; }
if [ -d /usr/lib/modules ] && ! [ -d "/usr/lib/modules/$(uname -r)" ]; then
  printf '\n%sThe kernel was updated. Please restart your computer when convenient.%s\n' "$Y" "$N"
fi
say "Apps you chose"
# Stream AUR builds live instead of hiding hours of work behind `tail`. sunshine-apps writes the
# full record to /var/log/sunshine/apps.log and prints the same progress here.
/usr/local/bin/sunshine-apps apply                      # AUR packages, setup and web apps that were waiting for the internet
/usr/local/bin/sunshine-apps first-update               # LibreOffice, Zen ...: offered on the very first update (once)
say "Health check"
/usr/local/bin/sunshine-doctor --fix --quiet || true
[ -n "${REAL_USER:-}" ] && { sudo -u "$REAL_USER" /usr/local/bin/sunshine-update-check seen; sudo -u "$REAL_USER" /usr/local/bin/sunshine-update-check --quiet; } >/dev/null 2>&1
if [ "$SUN_NIGHT" = 1 ]; then ok "$(t all_done_night "All done for tonight")"; else ok "$(t all_done "All done")"; fi
[ -x /usr/local/bin/sunshine-diagnose ] && [ -n "${REAL_USER:-}" ] && sudo -u "$REAL_USER" /usr/local/bin/sunshine-diagnose --after-update >/dev/null 2>&1 &
[ "$(sun_conf visuals_on_update off 2>/dev/null)" = on ] && [ -n "${REAL_USER:-}" ] && sudo -u "$REAL_USER" /usr/local/bin/sunshine-restore-visuals >/dev/null 2>&1
# The logo animation ends with the tool-specific message (night: a blue/pink logo and a rest message).
if [ "$SUN_NIGHT" = 1 ]; then sun_success_anim "$(t update_done_night "Rest well, sunshine 🌙")"; else sun_success_anim "$(t update_done "System updated")"; fi
cozy_done
finish 0

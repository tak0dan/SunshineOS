#!/bin/bash
# Sunshine top bar (after Garuda Dr460nized, plus live graphs): weather and the user switcher on the left, the clock exactly in the middle,
# live graphs (network, disk, CPU, GPU) on the right; no global menu. Run inside a Plasma session; `sunshine-topbar remove` takes it away.
Q=$(command -v qdbus6 || command -v qdbus) || exit 1
if [ "${1:-}" = remove ]; then
  "$Q" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'for (var p of panels()) if (p.location=="top") p.remove();' >/dev/null; exit 0
fi
# The applets are not always known to plasmashell right after login. Look first: a bar that already has its widgets is left alone (creating
# and removing panels in quick succession can crash plasmashell). Otherwise create it, wait, check again; give up after four tries.
count() {
  "$Q" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.dumpCurrentLayoutJS 2>/dev/null | python3 -c 'import json,sys
t=sys.stdin.read(); d=json.loads(t[t.index("{"):t.rindex("}")+1])
tp=[p for p in d.get("panels",[]) if p.get("location")=="top"]
old=any(a.get("plugin")=="org.kde.plasma.appmenu" for p in tp for a in p.get("applets",[]))   # an older bar with the global menu strip is rebuilt
print(sum(len(p.get("applets",[])) for p in tp) if len(tp)==3 and not old else 0)' 2>/dev/null
}
# Three solid panels that together span the whole width (40% + 20% + 40%, same colour): the clock in the middle panel is exactly at the centre of the
# screen whatever the global menu on the left or the graphs on the right take, and the bar reads as one piece.
for try in 1 2 3 4; do
  [ "${1:-}" = --force ] && [ "$try" = 1 ] || { n=$(count); [ "${n:-0}" -ge 3 ] 2>/dev/null && exit 0; }
  "$Q" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
for (var q of panels()) if (q.location=="top") q.remove();
var W = screenGeometry(0).width, L = Math.floor(W * 0.4), C = W - 2 * L, H = Math.round(gridUnit * 1.9);
function mk(al, len, ws) { var t = new Panel; t.location = "top"; t.floating = false; t.alignment = al; t.height = H; t.hiding = "none"; t.opacityMode = "opaque"; t.lengthMode = "custom"; t.minimumLength = len; t.maximumLength = len; for (var w of ws) t.addWidget(w); return t }
mk("left", L, ["org.kde.plasma.weather", "org.kde.plasma.userswitcher", "org.kde.plasma.panelspacer"]);
mk("center", C, ["org.kde.plasma.panelspacer", "org.kde.plasma.digitalclock", "org.kde.plasma.panelspacer"]);
mk("right", L, ["org.kde.plasma.panelspacer", "com.sunshineos.graphs"]);
' >/dev/null 2>&1
  sleep 10
done
n=$(count); [ "${n:-0}" -ge 3 ] 2>/dev/null && exit 0
echo "sunshine-topbar: the top bar could not be filled (plasmashell not ready?)" >&2
exit 1

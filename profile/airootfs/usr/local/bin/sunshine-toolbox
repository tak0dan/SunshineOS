#!/usr/bin/env python3
"""Sunshine Toolbox: maintenance and repair tools of Sunshine OS in one window."""
import os
import shutil
import subprocess
import sys

from PyQt6.QtCore import Qt
from PyQt6.QtGui import QFont, QIcon, QPixmap
from PyQt6.QtWidgets import (QApplication, QFrame, QGridLayout, QHBoxLayout, QLabel, QPushButton,
                             QScrollArea, QVBoxLayout, QWidget)

STYLE = """
QWidget { background: #0e1422; color: #efe5d0; font-size: 14px; }
QLabel#title { font-size: 26px; font-weight: bold; color: #ffc43d; }
QLabel#sub { color: #a89c88; }
QLabel#sec { font-size: 15px; font-weight: bold; color: #ff9654; padding-top: 10px; }
QPushButton { background: #1a202d; border: 1px solid #2a3550; border-radius: 10px; padding: 12px; text-align: left; }
QPushButton:hover { background: #262f47; border-color: #ff9654; }
QScrollArea { border: none; }
"""

ON_BTRFS = subprocess.run(["findmnt", "-no", "FSTYPE", "/"], capture_output=True, text=True).stdout.strip() == "btrfs"


def run(cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass


def term(command, title):
    """Run a command in a themed terminal and keep the window open so the result can be read."""
    run(["konsole", "--hide-menubar", "-p", f"tabtitle={title}", "-e", "bash", "-c",
         f"{command}; echo; read -rp 'Press Enter to close this window.' _"])


def have(binary):
    return shutil.which(binary) is not None


SECTIONS = [
    ("Keep it healthy", [
        ("🔄  Update everything", "System, apps and extras, with restore points", lambda: run(["sunshine-update"]), True),
        ("🩺  Health check", "Find and repair problems (identity, boot, packages, snapshots)", lambda: term("sunshine-doctor --fix", "Health check"), True),
        ("🧹  Clean up", "Free disk space: old downloads, unused packages, logs", lambda: term("sunshine-cleanup", "Clean up"), True),
        ("📦  Fix the package manager", "Lock file, keyring, mirrors, databases", lambda: term("sunshine-fix-pacman", "Fix pacman"), True),
    ]),
    ("Go back in time", [
        ("🛟  Restore points", "Browse, restore or delete snapshots (Btrfs Assistant)",
         lambda: run(["btrfs-assistant-launcher"]), ON_BTRFS and have("btrfs-assistant-launcher")),
        ("➕  Make a restore point now", "Save the current state before you try something",
         lambda: term("sunshine-snapshot create 'Before I tried something'", "Restore point"), ON_BTRFS),
    ]),
    ("Repair", [
        ("🥾  Repair the boot loader", "Reinstall GRUB and rebuild boot files", lambda: term("sunshine-boot-repair", "Boot repair"), True),
        ("🪪  Check the system identity", "Make sure the system is still Sunshine OS", lambda: term("sunshine-identity check; sunshine-identity apply", "Identity"), True),
    ]),
    ("Know your computer", [
        ("🖥  System information", "Hardware, kernel, desktop, packages (paste it when asking for help)",
         lambda: term("sunshine-info", "System information"), True),
        ("💽  Disks and partitions", "Partition Manager", lambda: run(["partitionmanager"]), have("partitionmanager")),
        ("🌐  Network", "Wi-Fi, cable, VPN", lambda: run(["kcmshell6", "kcm_networkmanagement"]), have("kcmshell6")),
        ("⚙  System settings", "Look, keyboard, language, sound", lambda: run(["systemsettings"]), have("systemsettings")),
    ]),
    ("Devices", [
        ("📱  Phone", "Pair a phone with KDE Connect: files, notifications, clipboard", lambda: run(["kdeconnect-app"]), have("kdeconnect-app")),
        ("🎧  AirPods", "Battery of each pod and the case, noise control", lambda: run(["sunshine-pods"]), have("sunshine-pods")),
    ]),
    ("Fun", [
        ("🐣  Sunshine Pet", "Feed it, wash it, play with it", lambda: run(["sunshine-pet"]), have("sunshine-pet")),
    ]),
    ("Apps", [
        ("🛍  Sunshine Store", "pacman, AUR and Flatpak in one place", lambda: run(["sunshine-store"]), have("sunshine-store")),
        ("🌐  Enable Flathub", "Thousands more apps",
         lambda: term("pkexec flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && echo Done", "Flathub"), have("flatpak")),
    ]),
]


class Toolbox(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Sunshine Toolbox")
        self.setMinimumSize(700, 620)
        self.setWindowIcon(QIcon("/usr/share/sunshine/logos/welcome.png"))
        outer = QVBoxLayout(self)
        outer.setContentsMargins(28, 24, 28, 18)
        head = QHBoxLayout()
        logo = QLabel()
        pm = QPixmap("/usr/share/sunshine/logos/welcome.png")
        if not pm.isNull():
            logo.setPixmap(pm.scaled(56, 56, Qt.AspectRatioMode.KeepAspectRatio, Qt.TransformationMode.SmoothTransformation))
            head.addWidget(logo)
        col = QVBoxLayout()
        t = QLabel("Sunshine Toolbox"); t.setObjectName("title"); col.addWidget(t)
        s = QLabel("Everything to keep Sunshine OS healthy, in one place."); s.setObjectName("sub"); col.addWidget(s)
        head.addLayout(col, 1)
        outer.addLayout(head)
        area = QScrollArea(); area.setWidgetResizable(True)
        area.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        inner = QWidget(); lay = QVBoxLayout(inner); lay.setContentsMargins(0, 0, 8, 0)
        for title, tools in SECTIONS:
            shown = [x for x in tools if x[3]]
            if not shown:
                continue
            h = QLabel(title); h.setObjectName("sec"); lay.addWidget(h)
            g = QGridLayout(); g.setSpacing(10)
            for i, (label, desc, fn, _) in enumerate(shown):
                b = QPushButton(f"{label}\n{desc}")
                b.setCursor(Qt.CursorShape.PointingHandCursor)
                b.clicked.connect(lambda _=False, f=fn: f())
                g.addWidget(b, i, 0)
            lay.addLayout(g)
        lay.addStretch(1)
        area.setWidget(inner)
        outer.addWidget(area, 1)


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("sunshine-toolbox")
    app.setStyleSheet(STYLE)
    app.setFont(QFont("Noto Sans", 10))
    w = Toolbox(); w.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())

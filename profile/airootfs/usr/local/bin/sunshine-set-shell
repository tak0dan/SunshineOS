#!/usr/bin/env bash
# Runs in the installed system after the user exists: Sunshine OS users get fish as their login shell.
[ -x /usr/bin/fish ] || exit 0
grep -qx /usr/bin/fish /etc/shells || echo /usr/bin/fish >> /etc/shells
awk -F: '$3>=1000 && $3<60000 {print $1}' /etc/passwd | while read -r u; do usermod -s /usr/bin/fish "$u"; done
exit 0

#!/usr/bin/env bash
# Sunshine OS installer: copies the live system to disk (offline, no network needed).
# Interactive (dialog) by default. Non-interactive: SUNSHINE_AUTO=1 plus
#   SUNSHINE_DISK=/dev/xxx SUNSHINE_USER=name SUNSHINE_PASS_FILE=/path/to/secret
#   [SUNSHINE_HOSTNAME=.. SUNSHINE_TZ=Europe/Madrid SUNSHINE_LOCALE=en_US.UTF-8
#    SUNSHINE_KEYMAP=us SUNSHINE_FS=ext4|btrfs SUNSHINE_ENCRYPT=yes
#    SUNSHINE_LUKS_PASS_FILE=/path/to/secret]
# Secrets are read from files, never from command-line arguments or environment values.
set -uo pipefail

TITLE="Sunshine OS Installer"
SRC=/run/archiso/airootfs
MNT=/mnt/sunshine-target
LOG=/var/log/sunshine-install.log
AUTO=${SUNSHINE_AUTO:-0}

[ "$(id -u)" -eq 0 ] || exec sudo -E "$0" "$@"
# Shared Sunshine look: animated progress graphs and the success logo for long steps.
[ -r /usr/local/lib/sunshine/ui.sh ] && . /usr/local/lib/sunshine/ui.sh
if ! declare -F sun_run >/dev/null 2>&1; then
  sun_run() { local label=$1; shift; printf '%s ...\n' "$label"; "$@"; }
fi
# Warm dark look for the dialogs (default dialog is bright blue)
export DIALOGRC=/tmp/sunshine-dialogrc
cat > "$DIALOGRC" <<'RC'
use_shadow = OFF
use_colors = ON
screen_color = (YELLOW,BLACK,ON)
dialog_color = (WHITE,BLACK,OFF)
title_color = (YELLOW,BLACK,ON)
border_color = (YELLOW,BLACK,ON)
border2_color = (YELLOW,BLACK,ON)
button_active_color = (BLACK,YELLOW,OFF)
button_inactive_color = (WHITE,BLACK,OFF)
button_key_active_color = (BLACK,YELLOW,OFF)
button_key_inactive_color = (YELLOW,BLACK,ON)
button_label_active_color = (BLACK,YELLOW,OFF)
button_label_inactive_color = (WHITE,BLACK,OFF)
menubox_color = (WHITE,BLACK,OFF)
menubox_border_color = (YELLOW,BLACK,OFF)
menubox_border2_color = (YELLOW,BLACK,OFF)
item_color = (WHITE,BLACK,OFF)
item_selected_color = (BLACK,YELLOW,OFF)
tag_color = (YELLOW,BLACK,OFF)
tag_selected_color = (BLACK,YELLOW,OFF)
tag_key_color = (YELLOW,BLACK,OFF)
tag_key_selected_color = (BLACK,YELLOW,OFF)
inputbox_color = (WHITE,BLACK,OFF)
inputbox_border_color = (YELLOW,BLACK,OFF)
inputbox_border2_color = (YELLOW,BLACK,OFF)
form_active_text_color = (BLACK,YELLOW,OFF)
form_text_color = (WHITE,BLACK,OFF)
check_color = (WHITE,BLACK,OFF)
check_selected_color = (BLACK,YELLOW,OFF)
position_indicator_color = (YELLOW,BLACK,ON)
searchbox_color = (WHITE,BLACK,OFF)
searchbox_title_color = (YELLOW,BLACK,ON)
searchbox_border_color = (YELLOW,BLACK,OFF)
searchbox_border2_color = (YELLOW,BLACK,OFF)
RC
exec > >(tee -a "$LOG") 2>&1

die()  { echo "ERROR: $*" >&2; command -v dialog >/dev/null && [ "$AUTO" != 1 ] && dialog --title "$TITLE" --msgbox "Installation failed:\n\n$*\n\nLog: $LOG" 12 70; cleanup; exit 1; }
info() { echo "==> $*"; }
read_secret_file() { local f=$1 v; [ -r "$f" ] || die "Cannot read secret file: $f"; IFS= read -r v < "$f" || true; [ -n "$v" ] || die "Empty secret file: $f"; printf '%s' "$v"; }

SECRET_TMP=
cleanup() {
  mountpoint -q "$MNT" && { sync; umount -R "$MNT" 2>/dev/null || umount -Rl "$MNT" 2>/dev/null; }
  [ -e /dev/mapper/cryptroot ] && cryptsetup close cryptroot 2>/dev/null
  if [ -n "$SECRET_TMP" ] && [ -f "$SECRET_TMP/luks.key" ]; then
    shred -u "$SECRET_TMP/luks.key" 2>/dev/null || rm -f "$SECRET_TMP/luks.key"
  fi
  [ -n "$SECRET_TMP" ] && rmdir "$SECRET_TMP" 2>/dev/null
}
trap 'cleanup' EXIT

[ -d "$SRC" ] || die "Not running from the Sunshine OS live ISO ($SRC missing)."
if [ -d /sys/firmware/efi/efivars ]; then BOOT=uefi; else BOOT=bios; fi

# ---------- inputs ----------
ask_input() { # var title default
  local v
  if [ "$AUTO" = 1 ]; then return; fi
  v=$(dialog --stdout --title "$TITLE" --inputbox "$2" 10 64 "$3") || { cleanup; exit 130; }
  printf -v "$1" '%s' "$v"
}

DISK=${SUNSHINE_DISK:-}
if [ -z "$DISK" ]; then
  [ "$AUTO" = 1 ] && die "SUNSHINE_DISK required in auto mode"
  mapfile -t rows < <(lsblk -dpno NAME,TYPE,SIZE,MODEL,TRAN -e 7,11,2 | awk '$2=="disk" && $1 !~ /zram|\/ram/ {$2=""; print}')
  [ ${#rows[@]} -gt 0 ] || die "No installable disks found."
  items=()
  for r in "${rows[@]}"; do n=${r%% *}; items+=("$n" "${r#* }"); done
  DISK=$(dialog --stdout --title "$TITLE" --menu "Select the target disk.\n\nTHE ENTIRE DISK WILL BE ERASED." 20 76 10 "${items[@]}") || { cleanup; exit 130; }
fi
[ -b "$DISK" ] || die "$DISK is not a block device."
# never allow installing onto the medium we booted from
live_dev=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)
[ -n "$live_dev" ] && [[ "$live_dev" == "$DISK"* ]] && die "$DISK is the live boot medium."

HOSTNAME_=${SUNSHINE_HOSTNAME:-sunshine}
USERNAME=${SUNSHINE_USER:-}
PASS=
[ -n "${SUNSHINE_PASS_FILE:-}" ] && PASS=$(read_secret_file "$SUNSHINE_PASS_FILE")
TZ_=${SUNSHINE_TZ:-UTC}
LOCALE=${SUNSHINE_LOCALE:-en_US.UTF-8}
KEYMAP=${SUNSHINE_KEYMAP:-us}
FS=${SUNSHINE_FS:-btrfs}
ENCRYPT=${SUNSHINE_ENCRYPT:-no}        # yes: LUKS-encrypt the system (passphrase asked at every boot)
LUKSPASS=
[ -n "${SUNSHINE_LUKS_PASS_FILE:-}" ] && LUKSPASS=$(read_secret_file "$SUNSHINE_LUKS_PASS_FILE")

if [ "$AUTO" != 1 ]; then
  ask_input HOSTNAME_ "Computer name:" "$HOSTNAME_"
  while :; do
    ask_input USERNAME "Username (lowercase letters, digits, - _):" "${USERNAME:-}"
    [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
    dialog --title "$TITLE" --msgbox "Invalid username." 7 40
  done
  while :; do
    p1=$(dialog --stdout --insecure --passwordbox "Password for $USERNAME (also used for administrator access):" 10 64) || { cleanup; exit 130; }
    p2=$(dialog --stdout --insecure --passwordbox "Repeat password:" 10 64) || { cleanup; exit 130; }
    [ -n "$p1" ] && [ "$p1" = "$p2" ] && { PASS=$p1; break; }
    dialog --title "$TITLE" --msgbox "Passwords are empty or do not match." 7 46
  done
  region=$(dialog --stdout --title "$TITLE" --no-tags --menu "Time zone region:" 20 50 12 \
    $(cd /usr/share/zoneinfo && for d in Africa America Antarctica Asia Atlantic Australia Europe Indian Pacific; do echo "$d" "$d"; done) UTC UTC) || { cleanup; exit 130; }
  if [ "$region" = UTC ]; then TZ_=UTC; else
    zone=$(dialog --stdout --title "$TITLE" --no-tags --menu "Time zone:" 22 50 14 \
      $(cd "/usr/share/zoneinfo/$region" && find . -type f | sed 's|^\./||' | sort | awk '{print $1, $1}')) || { cleanup; exit 130; }
    TZ_="$region/$zone"
  fi
  LOCALE=$(dialog --stdout --title "$TITLE" --menu "System language:" 20 60 12 \
    en_US.UTF-8 "English (US)" en_GB.UTF-8 "English (UK)" es_ES.UTF-8 "Español" ca_ES.UTF-8 "Català" \
    uk_UA.UTF-8 "Українська" fr_FR.UTF-8 "Français" de_DE.UTF-8 "Deutsch" it_IT.UTF-8 "Italiano" \
    pt_PT.UTF-8 "Português" pl_PL.UTF-8 "Polski" ru_RU.UTF-8 "Русский") || { cleanup; exit 130; }
  allmaps=$(localectl list-keymaps --no-pager)
  kitems=()
  for m in "us:English (US)" "uk:English (UK)" "es:Español" "ua:Українська" "de-latin1:Deutsch" "fr:Français" "it:Italiano" "pt-latin9:Português" "pl2:Polski" "ru:Русский"; do
    grep -qx "${m%%:*}" <<<"$allmaps" && kitems+=("${m%%:*}" "${m#*:}")
  done
  KEYMAP=$(dialog --stdout --title "$TITLE" --menu "Keyboard layout:" 22 60 14 "${kitems[@]}" more "More layouts…") || { cleanup; exit 130; }
  if [ "$KEYMAP" = more ]; then
    KEYMAP=$(dialog --stdout --title "$TITLE" --no-tags --menu "All keyboard layouts:" 22 60 14 $(awk '{print $1, $1}' <<<"$allmaps")) || { cleanup; exit 130; }
  fi
  FS=$(dialog --stdout --title "$TITLE" --menu "Filesystem:" 10 60 2 btrfs "btrfs (restore points, recommended)" ext4 "ext4 (simple, no restore points)") || { cleanup; exit 130; }
  if dialog --title "$TITLE" --defaultno --yesno "Encrypt the whole system?\n\nA passphrase will be asked every time the computer starts.\nIf it is forgotten, the data cannot be recovered." 11 62; then
    ENCRYPT=yes
    while :; do
      LUKSPASS=$(dialog --stdout --insecure --passwordbox "Disk encryption passphrase:" 10 64) || { cleanup; exit 130; }
      l2=$(dialog --stdout --insecure --passwordbox "Repeat the passphrase:" 10 64) || { cleanup; exit 130; }
      [ -n "$LUKSPASS" ] && [ "$LUKSPASS" = "$l2" ] && break
      dialog --title "$TITLE" --msgbox "The passphrases are empty or do not match. Try again." 7 56
    done
  fi
  dialog --title "$TITLE" --yesno "Ready to install:\n\n  Disk:      $DISK  (ERASED)\n  Boot mode: $BOOT\n  Hostname:  $HOSTNAME_\n  User:      $USERNAME\n  Time zone: $TZ_\n  Language:  $LOCALE\n  Keyboard:  $KEYMAP\n  Filesystem: $FS\n  Encrypted:  $ENCRYPT\n\nContinue?" 18 60 || { cleanup; exit 130; }
fi
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Invalid username '$USERNAME'."
[ -n "$PASS" ] || die "Empty password."
[ "$ENCRYPT" = yes ] && [ -z "$LUKSPASS" ] && LUKSPASS=$PASS
case "$FS" in ext4|btrfs) ;; *) die "Unsupported filesystem $FS";; esac
[ -e "/usr/share/zoneinfo/$TZ_" ] || die "Unknown time zone $TZ_"

# Keep the LUKS passphrase in a root-only temporary file so cryptsetup never sees it on a pipe.
if [ "$ENCRYPT" = yes ]; then
  SECRET_TMP=$(mktemp -d /run/sunshine-install.XXXXXX) || die "Cannot create secret directory"
  chmod 700 "$SECRET_TMP"
  ( umask 077; printf '%s' "$LUKSPASS" > "$SECRET_TMP/luks.key" ) || die "Cannot store LUKS key"
fi

# ---------- is the disk big enough? ----------
# The copy is the UNCOMPRESSED system (several times the ISO size). Check before erasing anything and say it plainly.
need=$(df -B1 --output=used "$SRC" 2>/dev/null | tail -1 | tr -dc 0-9); need=${need:-0}
have=$(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0)
want=$(( need + need / 8 + 3 * 1024 * 1024 * 1024 ))      # system + 12% + ESP/boot/free space
if [ "$have" -gt 0 ] && [ "$need" -gt 0 ] && [ "$have" -lt "$want" ]; then
  die "$DISK is too small: it holds $(( have / 1073741824 )) GiB, the installed system needs about $(( want / 1073741824 )) GiB ($(( need / 1073741824 )) GiB of files plus working room). Pick a bigger disk."
fi

# ---------- partition ----------
info "Partitioning $DISK ($BOOT)"
swapoff -a 2>/dev/null
umount -R "$MNT" 2>/dev/null
for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do umount "$p" 2>/dev/null; done
wipefs -af "$DISK" >/dev/null || die "wipefs failed"
sgdisk --zap-all "$DISK" >/dev/null 2>&1
if [ "$BOOT" = uefi ]; then
  sgdisk -n1:0:+2G -t1:ef00 -c1:SUNSHINE_ESP -n2:0:0 -t2:8304 -c2:sunshine-root "$DISK" || die "sgdisk failed"
else
  sgdisk -n1:0:+2M -t1:ef02 -c1:bios_grub -n2:0:0 -t2:8304 -c2:sunshine-root "$DISK" || die "sgdisk failed"
fi
partprobe "$DISK"; udevadm settle; sleep 1
case "$DISK" in *[0-9]) P="${DISK}p";; *) P="$DISK";; esac
ESP="${P}1"; ROOT="${P}2"
[ -b "$ROOT" ] || die "Partition $ROOT did not appear."
RAWROOT=$ROOT
if [ "$ENCRYPT" = yes ]; then
  info "Encrypting the system partition"
  # LUKS1: GRUB reads it directly, so the boot menu can unlock the disk (LUKS2 with Argon2 is not readable by GRUB)
  cryptsetup luksFormat --type luks1 --batch-mode "$RAWROOT" "$SECRET_TMP/luks.key" || die "cryptsetup luksFormat failed"
  cryptsetup open "$RAWROOT" cryptroot --key-file "$SECRET_TMP/luks.key" || die "cryptsetup open failed"
  ROOT=/dev/mapper/cryptroot
fi

info "Formatting"
# After a failed attempt the kernel can still hold the old filesystem registered ("Device or resource busy"): release it and try again
fmt() {
  local i
  for i in 1 2 3; do
    "$@" >/dev/null && return 0
    echo "formatting failed (try $i of 3): releasing the device and retrying"
    umount -R "$MNT" 2>/dev/null; swapoff -a 2>/dev/null
    command -v btrfs >/dev/null && btrfs device scan --forget >/dev/null 2>&1
    wipefs -af "${@: -1}" >/dev/null 2>&1; blockdev --rereadpt "$DISK" 2>/dev/null; partprobe "$DISK" 2>/dev/null; udevadm settle; sleep 3
  done
  return 1
}
[ "$BOOT" = uefi ] && { fmt mkfs.fat -F32 -n SUNSHINEESP "$ESP" || die "mkfs.fat failed on $ESP"; }
if [ "$FS" = btrfs ]; then fmt mkfs.btrfs -f -L sunshine "$ROOT" || die "mkfs.btrfs failed on $ROOT. The disk is still held by the kernel from an earlier attempt: reboot the live session and try again."; MOPT="noatime"
else fmt mkfs.ext4 -F -L sunshine "$ROOT" || die "mkfs.ext4 failed on $ROOT"; MOPT="noatime"; fi

mkdir -p "$MNT"
if [ "$FS" = btrfs ]; then
  # same layout as the graphical installer: @ (system), @home, @cache, @log
  mount "$ROOT" "$MNT" || die "mount root failed"
  for sv in @ @home @cache @log; do btrfs subvolume create "$MNT/$sv" >/dev/null || die "btrfs subvolume $sv failed"; done
  umount "$MNT"
  mount -o "$MOPT,subvol=@" "$ROOT" "$MNT" || die "mount root failed"
  mkdir -p "$MNT"/home "$MNT"/var/cache "$MNT"/var/log
  mount -o "$MOPT,subvol=@home" "$ROOT" "$MNT/home" && mount -o "$MOPT,subvol=@cache" "$ROOT" "$MNT/var/cache" && mount -o "$MOPT,subvol=@log" "$ROOT" "$MNT/var/log" || die "mount subvolumes failed"
else
  mount -o "$MOPT" "$ROOT" "$MNT" || die "mount root failed"
fi
if [ "$BOOT" = uefi ]; then mkdir -p "$MNT/boot/efi"; mount "$ESP" "$MNT/boot/efi" || die "mount ESP failed"; fi

# ---------- copy system ----------
copy_system() {
  rsync -aHAXx --info=progress2 --no-inc-recursive \
    --exclude=/boot/efi --exclude='/etc/pacman.d/gnupg' "$SRC"/ "$MNT"/ || {
    free=$(df -B1 --output=avail "$MNT" 2>/dev/null | tail -1 | tr -dc 0-9)
    if [ "${free:-1}" -lt 52428800 ]; then echo "The disk filled up while copying: it is too small for the installed system. Use a bigger disk."; else echo "rsync failed while copying the system."; fi
    return 1
  }
}
SUN_FIX_HINT="Check free space and disk errors; then restart the installer."
sun_run "Copying Sunshine OS to disk" copy_system || die "Copying the system failed (see $LOG)"
SUN_FIX_HINT="Check the output above; sunshine-doctor --fix repairs what is safe."
mkdir -p "$MNT"/{dev,proc,sys,run,tmp,mnt,boot/efi}
chmod 1777 "$MNT/tmp"

# kernel into /boot
for k in "$MNT"/usr/lib/modules/*/vmlinuz; do
  [ -f "$k" ] && { cp --sparse=never --reflink=never "$k" "$MNT/boot/vmlinuz-linux" && chmod 644 "$MNT/boot/vmlinuz-linux"; } && KVER=$(basename "$(dirname "$k")")
done
[ -f "$MNT/boot/vmlinuz-linux" ] || die "No kernel found in the system image."

genfstab -U "$MNT" > "$MNT/etc/fstab" || die "genfstab failed"
if [ "$ENCRYPT" = yes ]; then
  # key file inside the (encrypted) system and its initramfs: GRUB asks for the passphrase, the initramfs does not ask again
  dd if=/dev/urandom of="$MNT/crypto_keyfile.bin" bs=512 count=4 status=none && chmod 000 "$MNT/crypto_keyfile.bin" || die "keyfile creation failed"
  cryptsetup luksAddKey "$RAWROOT" "$MNT/crypto_keyfile.bin" --key-file "$SECRET_TMP/luks.key" || die "cryptsetup luksAddKey failed"
  LUKS_UUID=$(blkid -s UUID -o value "$RAWROOT")
fi

# ---------- remove live-session bits ----------
info "Removing live-session configuration"
cd "$MNT" || die "cd target"
rm -f  etc/mkinitcpio.conf.d/archiso.conf etc/sddm.conf.d/autologin.conf etc/sudoers.d/10-live \
       etc/ssh/sshd_config.d/10-archiso.conf etc/systemd/journald.conf.d/volatile-storage.conf \
       etc/systemd/logind.conf.d/do-not-suspend.conf root/.zlogin root/.automated_script.sh \
       etc/pacman.d/hooks/uncomment-mirrors.hook etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
       etc/systemd/system/choose-mirror.service etc/systemd/system/pacman-init.service \
       etc/systemd/system/etc-pacman.d-gnupg.mount etc/systemd/system/livecd-*.service \
       etc/systemd/system/sunshine-live-setup.service etc/systemd/system/multi-user.target.wants/sunshine-live-setup.service \
       etc/systemd/network/20-*.network etc/systemd/system/multi-user.target.wants/{choose-mirror,pacman-init,livecd-talk,sshd,vboxservice,vmtoolsd}.service \
       etc/systemd/system/sound.target.wants/livecd-alsa-unmuter.service
rm -f etc/systemd/system/ldconfig.service etc/systemd/system/systemd-update-done.service; rm -rf etc/systemd/system/pacman-init.service.d etc/systemd/system/getty@tty1.service.d etc/systemd/system/systemd-networkd-wait-online.service.d \
       home/sunshine
rm -f  etc/systemd/system/systemd-loop@.service
cat > etc/motd <<'EOF'
Sunshine OS
EOF
cd /

# ---------- chroot configuration ----------
info "Configuring installed system"
for d in dev proc sys run; do mount --rbind "/$d" "$MNT/$d" && mount --make-rslave "$MNT/$d"; done
[ -d /sys/firmware/efi/efivars ] && mount --bind /sys/firmware/efi/efivars "$MNT/sys/firmware/efi/efivars" 2>/dev/null

sun_run "Installing the Hyprland desktop" /usr/local/bin/sunshine-hyprland-install "$MNT" || true

echo "$HOSTNAME_" > "$MNT/etc/hostname"
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_" > "$MNT/etc/hosts"
ln -sf "/usr/share/zoneinfo/$TZ_" "$MNT/etc/localtime"
sed -i "s/^#\(${LOCALE//./\\.} \)/\1/; s/^#\(en_US\.UTF-8 \)/\1/" "$MNT/etc/locale.gen"
echo "LANG=$LOCALE" > "$MNT/etc/locale.conf"
printf 'KEYMAP=%s\n' "$KEYMAP" > "$MNT/etc/vconsole.conf"
install -d "$MNT/etc/X11/xorg.conf.d"

# Plasma/X keyboard follows console keymap when possible
cat > "$MNT/etc/sddm.conf.d/10-sunshine.conf" <<EOF
[Theme]
Current=sunshine
EOF

# initramfs: standard (non-archiso) preset
cat > "$MNT/etc/mkinitcpio.d/linux.preset" <<'EOF'
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default')
default_image="/boot/initramfs-linux.img"
EOF
{ echo 'HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block encrypt filesystems fsck)'
  [ "$ENCRYPT" = yes ] && echo 'FILES=(/crypto_keyfile.bin)'; } > "$MNT/etc/mkinitcpio.conf.d/sunshine.conf"

sun_run "Preparing restore points" /usr/local/bin/sunshine-snapshots-setup "$MNT" || true   # btrfs only: snapper, snapshot boot entries (after the initramfs config exists)
cat > "$MNT/root/.sunshine-chroot.sh" <<EOS
set -e
locale-gen
# microcode: userspace images must live in /boot for GRUB
pacman-key --init >/dev/null 2>&1 && pacman-key --populate >/dev/null 2>&1 || true
userdel -r sunshine 2>/dev/null || true
getent group sunshine >/dev/null && groupdel sunshine 2>/dev/null || true
useradd -m -G wheel,audio,video,storage,optical,lp,network,power,input,i2c -s /usr/bin/fish "$USERNAME"
passwd -l root >/dev/null
sed -i 's/^# \(%wheel ALL=(ALL:ALL) ALL\)/\1/' /etc/sudoers
mkinitcpio -k "$KVER" -g /boot/initramfs-linux.img
systemctl enable NetworkManager.service sddm.service bluetooth.service cups.socket power-profiles-daemon.service systemd-timesyncd.service systemd-resolved.service fstrim.timer >/dev/null 2>&1
systemctl set-default graphical.target
# the login screen starts on Plasma (the main desktop; Hyprland stays one click away in the session menu)
mkdir -p /var/lib/sddm; printf '[Last]\nSession=/usr/share/sunshine/wayland-sessions/plasma.desktop\nUser=%s\n' "$USERNAME" > /var/lib/sddm/state.conf; chown -R sddm:sddm /var/lib/sddm 2>/dev/null || true
# the live image runs systemd-networkd next to NetworkManager; on the installed system that only blocks the boot (its wait-online unit times out after 2 minutes)
systemctl disable systemd-networkd.service systemd-networkd.socket systemd-networkd-wait-online.service NetworkManager-wait-online.service >/dev/null 2>&1
systemctl mask systemd-networkd-wait-online.service >/dev/null 2>&1
# a virtual machine needs its guest service (clipboard, resolution, shutdown): the live-only symlinks were not copied, so enable the right one here
case "$(systemd-detect-virt 2>/dev/null)" in
  oracle) systemctl enable vboxservice.service >/dev/null 2>&1 ;;
  vmware) systemctl enable vmtoolsd.service vmware-vmblock-fuse.service >/dev/null 2>&1 ;;
  kvm|qemu) systemctl enable qemu-guest-agent.service spice-vdagentd.service >/dev/null 2>&1 ;;
esac
# take over the shipped sunshine-base package, so tool updates arrive with normal updates
/usr/local/bin/sunshine-register-base || true
/usr/local/bin/sunshine-identity apply --quiet
sed -i 's/^#\?GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Sunshine OS"/' /etc/default/grub
sed -i '/^#\?GRUB_THEME=/d;/^#\?GRUB_GFXMODE=/d;/^#\?GRUB_TERMINAL_OUTPUT=/d' /etc/default/grub
printf '%s\n' 'GRUB_DISABLE_OS_PROBER=false' 'GRUB_THEME="/usr/share/grub/themes/sunshine/theme.txt"' 'GRUB_GFXMODE=auto' 'GRUB_TERMINAL_OUTPUT=gfxterm' 'GRUB_GFXPAYLOAD_LINUX=keep' 'GRUB_DISABLE_BOOTNEXT=true' >> /etc/default/grub
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=6 vt.default_red=11,243,166,249,137,245,148,205,88,243,181,249,137,245,148,239 vt.default_grn=16,139,227,226,180,194,226,184,91,139,240,226,180,194,226,229 vt.default_blu=32,168,161,175,250,231,213,240,112,168,174,175,250,231,213,255"/' /etc/default/grub
EOS
( umask 077; printf '%s:%s\n' "$USERNAME" "$PASS" > "$MNT/root/.sunshine-cred" ) || die "Cannot store installation credentials"
cat >> "$MNT/root/.sunshine-chroot.sh" <<'EOS'
chpasswd < /root/.sunshine-cred
shred -u /root/.sunshine-cred
EOS
if [ "$ENCRYPT" = yes ]; then
  cat >> "$MNT/root/.sunshine-chroot.sh" <<EOS
sed -i '/^#\?GRUB_ENABLE_CRYPTODISK=/d;/^GRUB_CMDLINE_LINUX=/d' /etc/default/grub
printf '%s\n' 'GRUB_ENABLE_CRYPTODISK=y' 'GRUB_CMDLINE_LINUX="cryptdevice=UUID=$LUKS_UUID:cryptroot root=/dev/mapper/cryptroot cryptkey=rootfs:/crypto_keyfile.bin"' >> /etc/default/grub
EOS
fi
if [ "$BOOT" = uefi ]; then
  cat >> "$MNT/root/.sunshine-chroot.sh" <<'EOS'
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=SunshineOS --recheck || echo "NVRAM entry failed (continuing with removable path)"
grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck
EOS
else
  echo "grub-install --target=i386-pc --recheck $DISK" >> "$MNT/root/.sunshine-chroot.sh"
fi
echo 'grub-mkconfig -o /boot/grub/grub.cfg' >> "$MNT/root/.sunshine-chroot.sh"
SUN_SUCCESS_MSG="Installation configured"
sun_run "Configuring the installed system" chroot "$MNT" /bin/bash /root/.sunshine-chroot.sh || die "Configuration in chroot failed (see $LOG)"
SUN_SUCCESS_MSG=
rm -f "$MNT/root/.sunshine-chroot.sh"

# sanity checks before declaring success
[ -f "$MNT/boot/grub/grub.cfg" ] && grep -q "$(blkid -s UUID -o value "$ROOT")" "$MNT/boot/grub/grub.cfg" || die "grub.cfg does not reference the root filesystem."
[ -f "$MNT/boot/initramfs-linux.img" ] || die "initramfs missing."
[ "$BOOT" = uefi ] && { [ -f "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" ] || die "UEFI fallback loader missing."; }

info "Done."
cleanup
trap - EXIT
[ "$AUTO" = 1 ] || dialog --title "$TITLE" --msgbox "Sunshine OS is installed.\n\nRemove the installation medium and reboot." 9 56
echo "SUNSHINE_INSTALL_OK"

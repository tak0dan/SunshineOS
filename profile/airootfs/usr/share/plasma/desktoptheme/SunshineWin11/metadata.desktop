[Desktop Entry]
Name=SunshineWin11
Comment=Sunshine OS: Windows 11 layout in Sunshine colours (based on Win11OS-kde)

X-KDE-PluginInfo-Author=yeyushengfan258
X-KDE-PluginInfo-Email=yeyushengfan258@outlook.com
X-KDE-PluginInfo-Name=SunshineWin11
X-KDE-PluginInfo-Version=0.1
X-KDE-PluginInfo-Website=https://github.com/yeyushengfan258/Win11OS-kde
X-KDE-PluginInfo-Category=
X-KDE-PluginInfo-Depends=
X-KDE-PluginInfo-License=GPL 3.0
X-KDE-PluginInfo-EnabledByDefault=true

[ContrastEffect]
enabled=false
contrast=0.2
intensity=0.4
saturation=1.7

[Wallpaper]
defaultWallpaperTheme=SunshineWin11
defaultFileSuffix=.jpg
defaultWidth=3840
defaultHeight=2400

[AdaptiveTransparency]
enabled=true

/* Sunshine OS installer: one explicit dark-warm palette so nothing ends up dark-on-dark. */
QWidget { background-color: #1d1526; color: #f6ead6; }
QLabel, QCheckBox, QRadioButton, QGroupBox { background: transparent; color: #f6ead6; }
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit, QTextBrowser, QListView, QTreeView, QTableView, QAbstractItemView {
    background-color: #271c31; color: #f6ead6; border: 1px solid #5a4262; border-radius: 6px;
    selection-background-color: #ffb86b; selection-color: #2a1a0e; }
QComboBox QAbstractItemView { background-color: #271c31; color: #f6ead6; selection-background-color: #ffb86b; selection-color: #2a1a0e; }
QHeaderView::section { background-color: #33253f; color: #f6ead6; border: 0; padding: 4px; }
QPushButton { background-color: #3a2a47; color: #f6ead6; border: 1px solid #6a4f74; border-radius: 6px; padding: 6px 16px; }
QPushButton:hover { background-color: #4a3659; }
QPushButton:default, QPushButton:focus { border-color: #ffb86b; }
QPushButton:disabled { background-color: #2a2033; color: #8b7a8f; border-color: #3d2f48; }
QProgressBar { background-color: #271c31; border: 1px solid #5a4262; border-radius: 6px; text-align: center; color: #f6ead6; }
QProgressBar::chunk { background-color: #ffb86b; border-radius: 5px; }
QScrollBar:vertical { background: #1d1526; width: 12px; }
QScrollBar::handle:vertical { background: #5a4262; border-radius: 5px; min-height: 24px; }
QScrollBar:horizontal { background: #1d1526; height: 12px; }
QScrollBar::handle:horizontal { background: #5a4262; border-radius: 5px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QToolTip { background-color: #33253f; color: #f6ead6; border: 1px solid #ffb86b; }
#sidebarApp, #mainApp { background-color: #1d1526; }

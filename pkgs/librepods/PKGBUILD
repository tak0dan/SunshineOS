# Maintainer: Sunshine OS
# AirPods daemon (battery, noise control, ear detection) for Linux.
# Source: the "daemon/" directory of https://github.com/thisisgm/omarchy-pods (MIT plugin, GPL-3.0 daemon),
# itself a modified copy of https://github.com/kavishdevar/librepods (GPL-3.0). See daemon/UPSTREAM.md.
pkgname=librepods
pkgver=1.0.0.sunshine1
pkgrel=1
pkgdesc='AirPods daemon: battery of each pod and the case, noise control, ear detection (Sunshine OS build)'
arch=('x86_64')
url='https://github.com/kavishdevar/librepods'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-connectivity' 'qt6-svg' 'libpulse' 'openssl' 'bluez')
makedepends=('cmake' 'ninja' 'qt6-tools' 'pkgconf')
options=('!debug')

build() {
  cmake -S "$startdir/daemon" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # the packaged service runs the system binary and is started with the graphical session
  sed -i 's|ExecStart=%h/.local/bin/librepods|ExecStart=/usr/bin/librepods|' "$pkgdir/usr/share/systemd/user/librepods.service"
  install -d "$pkgdir/usr/lib/systemd/user"
  mv "$pkgdir/usr/share/systemd/user/librepods.service" "$pkgdir/usr/lib/systemd/user/librepods.service"
  install -Dm644 "$startdir/daemon/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/daemon/UPSTREAM.md" "$pkgdir/usr/share/doc/$pkgname/UPSTREAM.md"
}

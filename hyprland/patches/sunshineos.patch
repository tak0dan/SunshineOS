+++ b/dots/.config/hypr/hyprland/execs.lua
@@ -50,16 +50,17 @@ hl.on("hyprland.start", function ()
     hl.exec_cmd("qs -c $qsConfig")
     hl.exec_cmd("$HOME/.config/hypr/custom/scripts/__restore_video_wallpaper.sh")
 
-    -- Startup apps: the default terminal running cpmatrix on workspace 1 and
-    -- the default browser on workspace 2. Each is placed on its workspace at
-    -- launch only, so windows opened later go to the current workspace.
-    local term, web = first_available(terminal), first_available(browser)
-    if term then
-        hl.exec_cmd(running(term, "$HOME/.local/bin/cpmatrix"), { workspace = 1 })
-    end
+    -- Sunshine OS startup apps, each placed on its workspace at launch only:
+    -- 1 Sunshine Welcome, 2 the browser, 3 foot running btop; then back to workspace 1
+    hl.exec_cmd("/usr/local/bin/sunshine-welcome --autostart", { workspace = 1 })
+    local web = first_available(browser)
     if web then
         hl.exec_cmd(web, { workspace = 2 })
     end
+    if on_path("foot") and on_path("btop") then
+        hl.exec_cmd("foot -e btop", { workspace = 3 })
+    end
+    hl.exec_cmd("sleep 7; hyprctl dispatch 'hl.dsp.focus({workspace=1})'")
 
     -- Core components (authentication, lock screen, notification daemon)
     hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
